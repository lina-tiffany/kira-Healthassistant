# ============================================================
# KIRA HEALTH ASSISTANT - ENVIRONMENT CONFIGURATION
# ============================================================

# Application settings
SECRET_KEY=replace-with-a-secure-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# DATABASE SETTINGS
# ============================================================

# Use sqlite for initial development.
# Change to postgresql when PostgreSQL is configured.
DB_ENGINE=sqlite

# PostgreSQL configuration
DB_NAME=kira_health_db
DB_USER=kira_user
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# ============================================================
# FRONTEND CONNECTION
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# TIME AND LANGUAGE
# ============================================================

TIME_ZONE=Africa/Kigali
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,fr,rw

# ============================================================
# EMAIL CONFIGURATION
# ============================================================

# Development uses the console backend by default.
# Production should use SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

DEFAULT_FROM_EMAIL=KIRA Health Assistant <no-reply@example.com>
